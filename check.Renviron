# CRAN=https://github.com/r-devel/r-dev-web/blob/main/CRAN/QA/Kurt/.R/check.Renviron

# Suppress some NOTEs that we dont care about
_R_CHECK_XREFS_NOTE_MISSING_PACKAGE_ANCHORS_=true
_R_CHECK_PKG_SIZES_=FALSE
_R_CHECK_FORCE_SUGGESTS_=FALSE
_R_CHECK_CRAN_INCOMING_=FALSE
_R_CHECK_CRAN_INCOMING_REMOTE_=FALSE
_R_CHECK_DOC_SIZES_=FALSE
_R_CHECK_TOPLEVEL_FILES_=FALSE
_R_CHECK_TIMINGS_=5

# Try to remove debugging symbols (if they were compiled).
_R_SHLIB_STRIP_=TRUE

# If this is unset, R will check .so instead of .o files, which leads to different results
_R_SHLIB_BUILD_OBJECTS_SYMBOL_TABLES_=TRUE

# Help some packages
R_DEFAULT_INTERNET_TIMEOUT=150
R_TEXI2DVICMD=emulation
R_BROWSER=echo
R_PDFVIEWER=echo
RGL_USE_NULL=TRUE

# Get the latest available binary for dependencies
# On bioc it often happens a devel version does not build on Win or Mac.
# R_COMPILE_AND_INSTALL_PACKAGES=never

# Arrow config. This is similar to NOT_CRAN=true
# GCS gives absl linking error on arm64
ARROW_GCS=OFF
ARROW_R_DEV=TRUE
LIBARROW_BINARY=true
LIBARROW_MINIMAL=false
